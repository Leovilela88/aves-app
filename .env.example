# Backblaze B2 (S3-compatible)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=avesleo
B2_KEY_ID=your_key_id_here
B2_APP_KEY=your_application_key_here

# Auth do app (senha única que você vai usar pra entrar)
APP_PASSWORD=troque_isso_por_uma_senha_forte
SESSION_SECRET=troque_isso_por_uma_string_aleatoria_longa

# Caminho do SQLite (em produção no Railway, aponte pra um volume, ex: /data/videos.db)
DB_PATH=./videos.db
